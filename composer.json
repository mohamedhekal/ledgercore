{
    "name": "hekal/ledgercore",
    "description": "Double-entry ledger engine for Laravel ERP/fintech: balanced journals, immutable postings, balances, and period locks",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "accounting",
        "ledger",
        "double-entry",
        "journal",
        "erp",
        "fintech",
        "php",
        "laravel-package",
        "bookkeeping",
        "general-ledger",
        "accounting-engine"
    ],
    "authors": [
        {
            "name": "Mohamed Hekal"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/support": "^11.0|^12.0",
        "illuminate/database": "^11.0|^12.0",
        "illuminate/events": "^11.0|^12.0",
        "illuminate/contracts": "^11.0|^12.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0|^10.0",
        "pestphp/pest": "^3.0",
        "pestphp/pest-plugin-laravel": "^3.0",
        "laravel/pint": "^1.18",
        "phpstan/phpstan": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Hekal\\LedgerCore\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Hekal\\LedgerCore\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Hekal\\LedgerCore\\LedgerCoreServiceProvider"
            ],
            "aliases": {
                "Ledger": "Hekal\\LedgerCore\\Facades\\Ledger"
            }
        }
    },
    "scripts": {
        "test": "pest",
        "analyse": "phpstan analyse --memory-limit=512M",
        "format": "pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "homepage": "https://github.com/mohamedhekal/ledgercore",
    "support": {
        "issues": "https://github.com/mohamedhekal/ledgercore/issues",
        "source": "https://github.com/mohamedhekal/ledgercore"
    }
}
